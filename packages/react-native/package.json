{
  "name": "@kue-qa/react-native",
  "version": "0.5.0",
  "description": "Capture visual issues while developing Expo and React Native apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ischca/kue.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/Ischca/kue/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shake": {
      "types": "./dist/shake.d.ts",
      "default": "./dist/shake.js"
    },
    "./screenshot": {
      "types": "./dist/screenshot.d.ts",
      "default": "./dist/screenshot.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "expo-module.config.json",
    "ios/*.swift",
    "ios/*.podspec",
    "android/build.gradle",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java/**/*.kt",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "tsc -b tsconfig.build.json --clean",
    "build": "tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "expo": ">=54 <58",
    "expo-application": ">=7 <58",
    "expo-constants": ">=18 <58",
    "expo-device": ">=8 <58",
    "expo-file-system": ">=19 <58",
    "expo-image-manipulator": ">=14 <58",
    "expo-screen-capture": ">=8 <58",
    "expo-sensors": ">=15 <58",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-safe-area-context": ">=4",
    "react-native-view-shot": ">=4"
  },
  "peerDependenciesMeta": {
    "expo-sensors": {
      "optional": true
    },
    "expo-screen-capture": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "~19.2.2",
    "expo": "~57.0.14",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.12",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.4",
    "expo-image-manipulator": "~57.0.11",
    "expo-screen-capture": "~57.0.3",
    "expo-sensors": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-view-shot": "5.1.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
